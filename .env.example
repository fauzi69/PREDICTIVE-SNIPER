# ============================================================
# PREDICTIVE SNIPER - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control!
# ============================================================

# --- AI Configuration ---
# Primary: Xiaomi Mimo Platform
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v1

# Fallback: Groq (Free tier available)
GROQ_API_KEY=your_groq_api_key_here

# --- Blockchain Configuration ---
# Polygon RPC endpoint (Alchemy / Infura / QuickNode)
POLYGON_RPC=https://polygon-rpc.com

# Wallet private key (DO NOT share this!)
PRIVATE_KEY=your_private_key_here

# --- Agent Configuration ---
# Set to "false" to enable real on-chain transactions
SIMULATION_MODE=true
