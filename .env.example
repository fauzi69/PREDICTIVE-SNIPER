# ========================================
# 🛡️ WEB3 CONFIGURATION
# ========================================
# Your Polygon wallet private key (NEVER commit real key!)
PRIVATE_KEY=0x...your_private_key_here...

# Polygon RPC endpoint
POLYGON_RPC=https://polygon-rpc.com/
# Alternative: https://rpc-mainnet.maticvigil.com/

# USDC Contract Address on Polygon
USDC_CONTRACT=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# ========================================
# 🧠 AI PLATFORM CONFIGURATION (XIAOMI MIMO)
# ========================================
# Get your API key from https://platform.xiaomimimo.com/
MIMO_API_KEY=your_xiaomi_mimo_api_key_here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v1

# ========================================
# 🔄 FALLBACK AI CONFIGURATION (GROQ - Free)
# ========================================
# Get free API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ========================================
# 📊 POLYMARKET / PREDICTION MARKET CONFIG
# ========================================
# Polymarket GraphQL API endpoint
POLYMARKET_API=https://clob.polymarket.com

# Minimum margin to execute trade (default 20%)
MIN_MARGIN=0.20

# Maximum trade size in USDC
MAX_TRADE_SIZE=1000

# ========================================
# 📡 NEWS/RSS CONFIGURATION
# ========================================
# Update frequency in seconds
RSS_UPDATE_INTERVAL=60

# Max news items to store in cache
MAX_NEWS_CACHE=1000

# ========================================
# 💾 DATABASE CONFIGURATION
# ========================================
# Use 'sqlite' for local, 'redis' for distributed
CACHE_BACKEND=sqlite
SQLITE_DB_PATH=./data/sniper.db

# Optional Redis config
REDIS_URL=redis://localhost:6379/0

# ========================================
# 📝 LOGGING CONFIGURATION
# ========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./logs/sniper.log

# Max log file size in MB
LOG_MAX_SIZE=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ========================================
# 🚨 ALERT CONFIGURATION
# ========================================
# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ========================================
# 🔐 SECURITY
# ========================================
# Enable dry-run mode (no real transactions)
DRY_RUN=true

# API rate limit (requests per minute)
RATE_LIMIT=60

# Request timeout in seconds
REQUEST_TIMEOUT=30
